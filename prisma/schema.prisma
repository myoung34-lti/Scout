generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  OPEN
  CLOSED
  ON_HOLD
}

enum CandidateType {
  SOFTWARE_ENGINEER
  SYSTEMS_ENGINEER
  ANALYST
  INTERNAL
}

enum PipelineStage {
  APPLIED
  SCREENING
  INTRODUCTORY_CALL
  BEHAVIORAL_INTERVIEW
  TECHNICAL_INTERVIEW
  EXECUTIVE_INTERVIEW
  CLIENT_INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum RejectionReason {
  COMMUNICATION
  CORE_VALUE_MISMATCH
  LACK_OF_TECHNICAL_SKILLS
  POSITION_FILLED
  POSITION_CLOSED
}

// Single value today — the Admin page is built to manage whichever roles
// exist, so adding e.g. ADMIN or INTERVIEWER later is just a new enum value.
enum Role {
  RECRUITER
}

// Profile row for a Supabase-authenticated team member.
// `id` mirrors the corresponding auth.users.id from Supabase Auth —
// no local password/credential storage here.
model User {
  id              String         @id @db.Uuid
  name            String
  email           String         @unique
  role            Role           @default(RECRUITER)
  createdAt       DateTime       @default(now())
  notes           ActivityNote[]
  stageChanges    StageHistory[]
  ownedCandidates Candidate[]    @relation("CandidateOwner")
  talentPoolAdds  Candidate[]    @relation("TalentPoolAdder")
  uploadedResumes Resume[]
}

model Job {
  id                      String        @id @default(cuid())
  internalName            String
  externalName            String
  location                String
  isRemote                Boolean       @default(false)
  isHybrid                Boolean       @default(false)
  whoWereLookingFor       String?
  primaryResponsibilities String[]      @default([])
  mustHaves               String[]      @default([])
  otherInformation        String?
  status                  JobStatus     @default(OPEN)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  applications            Application[]
}

model Candidate {
  id                  String         @id @default(cuid())
  firstName           String
  lastName            String
  email               String?
  phone               String?
  linkedinUrl         String?
  currentCompany      String?
  currentTitle        String?
  candidateType       CandidateType?
  location            String?
  rating              Int?
  ownerId             String?        @db.Uuid
  owner               User?          @relation("CandidateOwner", fields: [ownerId], references: [id])
  inTalentPool        Boolean        @default(false)
  talentPoolAddedAt   DateTime?
  talentPoolAddedById String?        @db.Uuid
  talentPoolAddedBy   User?          @relation("TalentPoolAdder", fields: [talentPoolAddedById], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  applications        Application[]
  tags                CandidateTag[]
  notes               ActivityNote[]
  resumes             Resume[]

  @@index([email])
  @@index([inTalentPool])
}

model Resume {
  id           String    @id @default(cuid())
  candidateId  String
  fileName     String
  storagePath  String
  fileSize     Int
  uploadedAt   DateTime  @default(now())
  uploadedById String    @db.Uuid
  candidate    Candidate @relation(fields: [candidateId], references: [id])
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])

  @@index([candidateId, uploadedAt])
}

model Application {
  id              String           @id @default(cuid())
  candidateId     String
  jobId           String
  stage           PipelineStage    @default(APPLIED)
  rejectionReason RejectionReason?
  appliedAt       DateTime         @default(now())
  hiredAt         DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  candidate       Candidate        @relation(fields: [candidateId], references: [id])
  job             Job              @relation(fields: [jobId], references: [id])
  history         StageHistory[]
  notes           ActivityNote[]

  @@index([candidateId])
  @@index([jobId])
}

model StageHistory {
  id            String         @id @default(cuid())
  applicationId String
  fromStage     PipelineStage?
  toStage       PipelineStage
  changedById   String         @db.Uuid
  changedAt     DateTime       @default(now())
  application   Application    @relation(fields: [applicationId], references: [id])
  changedBy     User           @relation(fields: [changedById], references: [id])

  @@index([applicationId])
}

model Tag {
  id           String         @id @default(cuid())
  label        String         @unique
  displayLabel String
  createdAt    DateTime       @default(now())
  candidates   CandidateTag[]
}

model CandidateTag {
  candidateId String
  tagId       String
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  tag         Tag       @relation(fields: [tagId], references: [id])

  @@id([candidateId, tagId])
}

model ActivityNote {
  id            String         @id @default(cuid())
  candidateId   String
  applicationId String?
  stage         PipelineStage?
  authorId      String         @db.Uuid
  body          String
  createdAt     DateTime       @default(now())
  candidate     Candidate      @relation(fields: [candidateId], references: [id])
  application   Application?   @relation(fields: [applicationId], references: [id])
  author        User           @relation(fields: [authorId], references: [id])

  @@index([candidateId, createdAt])
}
