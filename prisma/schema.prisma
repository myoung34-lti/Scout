generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  OPEN
  CLOSED
  ON_HOLD
}

enum CandidateType {
  SOFTWARE_ENGINEER
  SYSTEMS_ENGINEER
  ANALYST
  INTERNAL
  DEVOPS_ENGINEER
}

enum CandidateSource {
  LINKEDIN
  REFERRAL
  APPLIED
  CAREER_FAIR
}

enum PipelineStage {
  APPLIED
  SCREENING
  INTRODUCTORY_CALL
  BEHAVIORAL_INTERVIEW
  TECHNICAL_INTERVIEW
  EXECUTIVE_INTERVIEW
  CLIENT_INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum RejectionReason {
  COMMUNICATION
  CORE_VALUE_MISMATCH
  LACK_OF_TECHNICAL_SKILLS
  POSITION_FILLED
  POSITION_CLOSED
}

// Single value today — the Admin page is built to manage whichever roles
// exist, so adding e.g. ADMIN or INTERVIEWER later is just a new enum value.
enum Role {
  RECRUITER
}

// One value per interview-related pipeline stage — see
// INTERVIEW_STAGE_FOR_TYPE in lib/interview.ts for the 1:1 mapping used to
// connect a completed interview's recommendation back to its stage.
enum InterviewType {
  INTRO
  BEHAVIORAL
  TECHNICAL
  EXECUTIVE
  CLIENT
}

enum InterviewStatus {
  DRAFT
  COMPLETED
}

enum InterviewRecommendation {
  STRONG_NO
  NO
  MAYBE
  YES
  STRONG_YES
}

// Profile row for a Supabase-authenticated team member.
// `id` mirrors the corresponding auth.users.id from Supabase Auth —
// no local password/credential storage here.
model User {
  id                    String          @id @db.Uuid
  name                  String
  email                 String          @unique
  role                  Role            @default(RECRUITER)
  createdAt             DateTime        @default(now())
  notes                 ActivityNote[]
  stageChanges          StageHistory[]
  ownedCandidates       Candidate[]     @relation("CandidateOwner")
  talentPoolAdds        Candidate[]     @relation("TalentPoolAdder")
  uploadedResumes       Resume[]
  interviews            Interview[]
  createdPrompts        Prompt[]        @relation("PromptCreatedBy")
  updatedPrompts        Prompt[]        @relation("PromptUpdatedBy")
  createdPromptVersions PromptVersion[] @relation("PromptVersionCreatedBy")
}

model Job {
  id                      String        @id @default(cuid())
  internalName            String
  externalName            String
  location                String
  isRemote                Boolean       @default(false)
  isHybrid                Boolean       @default(false)
  whoWereLookingFor       String?
  primaryResponsibilities String[]      @default([])
  mustHaves               String[]      @default([])
  otherInformation        String?
  status                  JobStatus     @default(OPEN)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  applications            Application[]
}

model Candidate {
  id                  String           @id @default(cuid())
  firstName           String
  lastName            String
  email               String?
  phone               String?
  linkedinUrl         String?
  currentCompany      String?
  currentTitle        String?
  candidateType       CandidateType?
  source              CandidateSource?
  location            String?
  rating              Int?
  ownerId             String?          @db.Uuid
  owner               User?            @relation("CandidateOwner", fields: [ownerId], references: [id])
  inTalentPool        Boolean          @default(false)
  talentPoolAddedAt   DateTime?
  talentPoolAddedById String?          @db.Uuid
  talentPoolAddedBy   User?            @relation("TalentPoolAdder", fields: [talentPoolAddedById], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  applications        Application[]
  tags                CandidateTag[]
  notes               ActivityNote[]
  resumes             Resume[]
  interviews          Interview[]

  @@index([email])
  @@index([inTalentPool])
}

model Resume {
  id           String    @id @default(cuid())
  candidateId  String
  fileName     String
  storagePath  String
  fileSize     Int
  uploadedAt   DateTime  @default(now())
  uploadedById String    @db.Uuid
  candidate    Candidate @relation(fields: [candidateId], references: [id])
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])

  @@index([candidateId, uploadedAt])
}

model Application {
  id              String           @id @default(cuid())
  candidateId     String
  jobId           String
  stage           PipelineStage    @default(APPLIED)
  rejectionReason RejectionReason?
  appliedAt       DateTime         @default(now())
  hiredAt         DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  candidate       Candidate        @relation(fields: [candidateId], references: [id])
  job             Job              @relation(fields: [jobId], references: [id])
  history         StageHistory[]
  notes           ActivityNote[]
  interviews      Interview[]

  @@index([candidateId])
  @@index([jobId])
}

model StageHistory {
  id            String         @id @default(cuid())
  applicationId String
  fromStage     PipelineStage?
  toStage       PipelineStage
  changedById   String         @db.Uuid
  changedAt     DateTime       @default(now())
  application   Application    @relation(fields: [applicationId], references: [id])
  changedBy     User           @relation(fields: [changedById], references: [id])

  @@index([applicationId])
}

model Tag {
  id           String         @id @default(cuid())
  label        String         @unique
  displayLabel String
  createdAt    DateTime       @default(now())
  candidates   CandidateTag[]
}

model CandidateTag {
  candidateId String
  tagId       String
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  tag         Tag       @relation(fields: [tagId], references: [id])

  @@id([candidateId, tagId])
}

model ActivityNote {
  id            String         @id @default(cuid())
  candidateId   String
  applicationId String?
  stage         PipelineStage?
  authorId      String         @db.Uuid
  body          String
  createdAt     DateTime       @default(now())
  candidate     Candidate      @relation(fields: [candidateId], references: [id])
  application   Application?   @relation(fields: [applicationId], references: [id])
  author        User           @relation(fields: [authorId], references: [id])

  @@index([candidateId, createdAt])
}

// Interviews are candidate-scoped, not job-scoped — Scout may interview a
// strong candidate with no open application at all. applicationId is an
// optional cross-reference, never a requirement.
model Interview {
  id               String                   @id @default(cuid())
  candidateId      String
  applicationId    String?
  interviewerId    String                   @db.Uuid
  type             InterviewType
  status           InterviewStatus          @default(DRAFT)
  notes            String?
  firefliesSummary String?
  recommendation   InterviewRecommendation?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  completedAt      DateTime?
  candidate        Candidate                @relation(fields: [candidateId], references: [id])
  application      Application?             @relation(fields: [applicationId], references: [id])
  interviewer      User                     @relation(fields: [interviewerId], references: [id])

  @@index([candidateId, createdAt])
}

enum PromptCategory {
  INTERVIEW
  CANDIDATE
  COMMUNICATION
  ANALYSIS
  SYSTEM
}

// The single source of truth for every AI instruction used in Scout —
// features retrieve content exclusively through getActivePromptContent(key)
// in lib/prompts.ts, never by querying this table directly.
model Prompt {
  id               String          @id @default(cuid())
  key              String          @unique
  name             String
  description      String?
  category         PromptCategory
  isActive         Boolean         @default(true)
  // Points at whichever PromptVersion is currently live. A direct pointer
  // (rather than an isCurrent flag on PromptVersion) makes "which version is
  // active" a single column read, and structurally impossible to have more
  // than one current version per prompt.
  currentVersionId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdById      String          @db.Uuid
  updatedById      String          @db.Uuid
  createdBy        User            @relation("PromptCreatedBy", fields: [createdById], references: [id])
  updatedBy        User            @relation("PromptUpdatedBy", fields: [updatedById], references: [id])
  currentVersion   PromptVersion?  @relation("PromptCurrentVersion", fields: [currentVersionId], references: [id])
  versions         PromptVersion[] @relation("PromptVersions")

  @@index([category])
}

// Immutable history — created once, never edited or deleted. Editing a
// prompt always creates a new row and repoints Prompt.currentVersionId;
// restoring an old version copies its content into a new row the same way.
model PromptVersion {
  id          String   @id @default(cuid())
  promptId    String
  version     Int
  content     String   @db.Text
  createdAt   DateTime @default(now())
  createdById String   @db.Uuid
  prompt      Prompt   @relation("PromptVersions", fields: [promptId], references: [id])
  createdBy   User     @relation("PromptVersionCreatedBy", fields: [createdById], references: [id])
  currentFor  Prompt?  @relation("PromptCurrentVersion")

  @@unique([promptId, version])
  @@index([promptId, createdAt])
}
