generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JobStatus {
  OPEN
  CLOSED
  ON_HOLD
}

enum CandidateSource {
  LINKEDIN
  REFERRAL
  APPLIED
  CAREER_FAIR
}

enum PipelineStage {
  APPLIED
  SCREENING
  INTRODUCTORY_CALL
  BEHAVIORAL_INTERVIEW
  TECHNICAL_INTERVIEW
  EXECUTIVE_INTERVIEW
  CLIENT_INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum RejectionReason {
  COMMUNICATION
  CORE_VALUE_MISMATCH
  LACK_OF_TECHNICAL_SKILLS
  POSITION_FILLED
  POSITION_CLOSED
  ACCEPTED_ANOTHER_OFFER
  NOT_LOCAL
  PREFER_REMOTE
  // Free-text reason typed in at rejection time — see
  // Application.customRejectionReason for the actual text.
  OTHER
}

// Single value today — the Admin page is built to manage whichever roles
// exist, so adding e.g. ADMIN or INTERVIEWER later is just a new enum value.
enum Role {
  RECRUITER
}

// One value per interview-related pipeline stage — see
// INTERVIEW_STAGE_FOR_TYPE in lib/interview.ts for the 1:1 mapping used to
// connect a completed interview's recommendation back to its stage.
enum InterviewType {
  INTRO
  BEHAVIORAL
  TECHNICAL
  EXECUTIVE
  CLIENT
}

enum InterviewStatus {
  DRAFT
  COMPLETED
}

enum InterviewRecommendation {
  STRONG_NO
  NO
  MAYBE
  YES
  STRONG_YES
}

// Profile row for a Supabase-authenticated team member.
// `id` mirrors the corresponding auth.users.id from Supabase Auth —
// no local password/credential storage here.
model User {
  id                           String                 @id @db.Uuid
  name                         String
  email                        String                 @unique
  role                         Role                   @default(RECRUITER)
  createdAt                    DateTime               @default(now())
  // Captured once, right after Google sign-in grants the gmail.send scope —
  // used to mint fresh access tokens for sending candidate email as this
  // user. Null until they've signed in at least once since this shipped.
  googleRefreshToken           String?                @db.Text
  notes                        ActivityNote[]
  stageChanges                 StageHistory[]
  ownedCandidates              Candidate[]            @relation("CandidateOwner")
  talentPoolAdds               Candidate[]            @relation("TalentPoolAdder")
  uploadedResumes              Resume[]
  interviews                   Interview[]
  createdPrompts               Prompt[]               @relation("PromptCreatedBy")
  updatedPrompts               Prompt[]               @relation("PromptUpdatedBy")
  createdPromptVersions        PromptVersion[]        @relation("PromptVersionCreatedBy")
  sentEmails                   CandidateEmail[]
  createdEmailTemplates        EmailTemplate[]        @relation("EmailTemplateCreatedBy")
  updatedEmailTemplates        EmailTemplate[]        @relation("EmailTemplateUpdatedBy")
  createdEmailTemplateVersions EmailTemplateVersion[] @relation("EmailTemplateVersionCreatedBy")
  generatedInsights            CandidateInsight[]
  askScoutMessages             AskScoutMessage[]
  savedReports                 SavedReport[]
  jobAssignments               JobAssignment[]
}

model Job {
  id              String        @id @default(cuid())
  internalName    String
  externalName    String
  clientName      String?
  teamName        String?
  location        String
  isOnsite        Boolean       @default(false)
  isRemote        Boolean       @default(false)
  isHybrid        Boolean       @default(false)
  description     String?       @db.Text
  status          JobStatus     @default(OPEN)
  // External-system identity for imports (e.g. Greenhouse migration) — lets
  // a rerun upsert by source ID instead of duplicating on name/email match.
  greenhouseJobId BigInt?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]
  // A role can be worked by several recruiters and several sourcers at once,
  // so staffing is a join rather than one column per seat.
  assignments     JobAssignment[]
}

enum JobAssignmentRole {
  RECRUITER
  SOURCER
}

model JobAssignment {
  id        String            @id @default(cuid())
  jobId     String
  userId    String            @db.Uuid
  role      JobAssignmentRole
  createdAt DateTime          @default(now())
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])

  // Someone can be both recruiter and sourcer on a job, but only once in
  // each capacity.
  @@unique([jobId, userId, role])
  @@index([userId, role])
  @@index([jobId])
}

model Candidate {
  id                    String            @id @default(cuid())
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  linkedinUrl           String?
  currentCompany        String?
  currentTitle          String?
  source                CandidateSource?
  location              String?
  rating                Int?
  ownerId               String?           @db.Uuid
  owner                 User?             @relation("CandidateOwner", fields: [ownerId], references: [id])
  inTalentPool          Boolean           @default(false)
  talentPoolAddedAt     DateTime?
  talentPoolAddedById   String?           @db.Uuid
  talentPoolAddedBy     User?             @relation("TalentPoolAdder", fields: [talentPoolAddedById], references: [id])
  greenhouseCandidateId BigInt?           @unique
  // Both resume-scraped — workHistory is a WorkHistoryEntry[] (see
  // lib/actions/resume-parser.ts), wholesale-replaced on each scan rather
  // than modeled relationally, since it's read-only derived data, not
  // something anyone edits entry-by-entry in the app.
  yearsExperience       Float?
  workHistory           Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  applications          Application[]
  tags                  CandidateTag[]
  notes                 ActivityNote[]
  resumes               Resume[]
  interviews            Interview[]
  emails                CandidateEmail[]
  insight               CandidateInsight?
  askScoutMessages      AskScoutMessage[]

  @@index([email])
  @@index([inTalentPool])
  @@index([createdAt])
}

// A cached, AI-generated summary of a candidate's recruiting history —
// distilled from CandidateContext (see lib/ai/candidate-context.ts), not a
// second source of truth. Regenerated wholesale on demand (never merged),
// never regenerated automatically. Every field is nullable — a field is
// null when the underlying context doesn't support an answer, displayed as
// "Not recorded" rather than persisting that string literally (keeps the
// data layer clean for things like the email-personalization prompt, which
// simply omits null fields instead of citing "Not recorded" as if it were
// real signal).
model CandidateInsight {
  id                     String    @id @default(cuid())
  candidateId            String    @unique
  currentRoleCompany     String?   @db.Text
  desiredCompensation    String?   @db.Text
  whatTheyWantNext       String?   @db.Text
  motivationForChange    String?   @db.Text
  onsiteRemotePreference String?   @db.Text
  locationRelocation     String?   @db.Text
  technicalInterests     String?   @db.Text
  personalInterests      String?   @db.Text
  personalDetails        String?   @db.Text
  concernsOpenQuestions  String?   @db.Text
  generatedAt            DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  generatedById          String    @db.Uuid
  candidate              Candidate @relation(fields: [candidateId], references: [id])
  generatedBy            User      @relation(fields: [generatedById], references: [id])
}

// A persisted Ask Scout Q&A pair — saved so a recruiter (any recruiter,
// same shared-record model as ActivityNote) doesn't have to re-ask the
// same question, and so the answer survives a page reload. Not a full
// multi-turn chat — each row is a single independent question/answer,
// same as how Ask Scout itself has no memory of prior questions in a
// session today.
model AskScoutMessage {
  id          String    @id @default(cuid())
  candidateId String
  askedById   String    @db.Uuid
  question    String    @db.Text
  answer      String    @db.Text
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  askedBy     User      @relation(fields: [askedById], references: [id])

  @@index([candidateId, createdAt])
}

// A saved report configuration — never a frozen snapshot of results.
// Reopening always re-runs `definition` against live data via
// lib/reporting/reporting-service.ts. Shared with everyone, same
// collaborative model as the rest of Scout.
model SavedReport {
  id            String   @id @default(cuid())
  name          String
  description   String?
  visualization String
  definition    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String   @db.Uuid
  createdBy     User     @relation(fields: [createdById], references: [id])
}

model Resume {
  id                     String    @id @default(cuid())
  candidateId            String
  fileName               String
  storagePath            String
  fileSize               Int
  uploadedAt             DateTime  @default(now())
  uploadedById           String    @db.Uuid
  greenhouseAttachmentId BigInt?   @unique
  candidate              Candidate @relation(fields: [candidateId], references: [id])
  uploadedBy             User      @relation(fields: [uploadedById], references: [id])

  @@index([candidateId, uploadedAt])
}

model Application {
  id                      String           @id @default(cuid())
  candidateId             String
  jobId                   String
  stage                   PipelineStage    @default(APPLIED)
  rejectionReason         RejectionReason?
  customRejectionReason   String?
  appliedAt               DateTime         @default(now())
  hiredAt                 DateTime?
  rejectedAt              DateTime?
  greenhouseApplicationId BigInt?          @unique
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  candidate               Candidate        @relation(fields: [candidateId], references: [id])
  job                     Job              @relation(fields: [jobId], references: [id])
  history                 StageHistory[]
  notes                   ActivityNote[]
  interviews              Interview[]
  emails                  CandidateEmail[]

  @@index([candidateId])
  @@index([jobId])
  @@index([stage])
  @@index([hiredAt])
  @@index([rejectedAt])
  @@index([appliedAt])
}

model StageHistory {
  id            String         @id @default(cuid())
  applicationId String
  fromStage     PipelineStage?
  toStage       PipelineStage
  changedById   String         @db.Uuid
  changedAt     DateTime       @default(now())
  application   Application    @relation(fields: [applicationId], references: [id])
  changedBy     User           @relation(fields: [changedById], references: [id])

  @@index([applicationId])
  @@index([changedAt])
  @@index([changedById])
}

model Tag {
  id           String         @id @default(cuid())
  label        String         @unique
  displayLabel String
  createdAt    DateTime       @default(now())
  candidates   CandidateTag[]
}

model CandidateTag {
  candidateId String
  tagId       String
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  tag         Tag       @relation(fields: [tagId], references: [id])

  @@id([candidateId, tagId])
}

model ActivityNote {
  id               String         @id @default(cuid())
  candidateId      String
  applicationId    String?
  stage            PipelineStage?
  authorId         String         @db.Uuid
  body             String
  greenhouseNoteId BigInt?        @unique
  createdAt        DateTime       @default(now())
  candidate        Candidate      @relation(fields: [candidateId], references: [id])
  application      Application?   @relation(fields: [applicationId], references: [id])
  author           User           @relation(fields: [authorId], references: [id])

  @@index([candidateId, createdAt])
}

// Interviews are candidate-scoped, not job-scoped — Scout may interview a
// strong candidate with no open application at all. applicationId is an
// optional cross-reference, never a requirement.
model Interview {
  id                       String                   @id @default(cuid())
  candidateId              String
  applicationId            String?
  interviewerId            String                   @db.Uuid
  type                     InterviewType
  status                   InterviewStatus          @default(DRAFT)
  notes                    String?
  firefliesSummary         String?
  // Which PromptVersion was current when firefliesSummary was last saved —
  // lets us trace which prompt produced a given summary later, without
  // duplicating the prompt text itself into the Interview record.
  firefliesPromptVersionId String?
  // Intro-call-only: expected/discussed compensation, captured while it's
  // top of mind rather than relying on notes.
  compensationNotes        String?
  recommendation           InterviewRecommendation?
  // Free-text elaboration on `recommendation` — required alongside it
  // before an interview can be marked complete, for every interview type.
  recommendationNotes      String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  completedAt              DateTime?
  candidate                Candidate                @relation(fields: [candidateId], references: [id])
  application              Application?             @relation(fields: [applicationId], references: [id])
  interviewer              User                     @relation(fields: [interviewerId], references: [id])
  firefliesPromptVersion   PromptVersion?           @relation(fields: [firefliesPromptVersionId], references: [id])

  @@index([candidateId, createdAt])
  @@index([interviewerId, completedAt])
  @@index([status, completedAt])
}

enum PromptCategory {
  INTERVIEW
  CANDIDATE
  ANALYSIS
  SYSTEM
}

// The single source of truth for every AI instruction used in Scout —
// features retrieve content exclusively through getActivePromptContent(key)
// in lib/prompts.ts, never by querying this table directly.
model Prompt {
  id               String          @id @default(cuid())
  key              String          @unique
  name             String
  description      String?
  category         PromptCategory
  // Optional: which interview type's Fireflies-summary prompt this is.
  // Not DB-enforced to be unique per type — if two active prompts somehow
  // claim the same type, the most recently updated one wins (see
  // getActivePromptForInterviewType in lib/prompts.ts).
  interviewType    InterviewType?
  isActive         Boolean         @default(true)
  // Points at whichever PromptVersion is currently live. A direct pointer
  // (rather than an isCurrent flag on PromptVersion) makes "which version is
  // active" a single column read, and structurally impossible to have more
  // than one current version per prompt.
  currentVersionId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdById      String          @db.Uuid
  updatedById      String          @db.Uuid
  createdBy        User            @relation("PromptCreatedBy", fields: [createdById], references: [id])
  updatedBy        User            @relation("PromptUpdatedBy", fields: [updatedById], references: [id])
  currentVersion   PromptVersion?  @relation("PromptCurrentVersion", fields: [currentVersionId], references: [id])
  versions         PromptVersion[] @relation("PromptVersions")

  @@index([category])
  @@index([interviewType])
}

// Immutable history — created once, never edited or deleted. Editing a
// prompt always creates a new row and repoints Prompt.currentVersionId;
// restoring an old version copies its content into a new row the same way.
model PromptVersion {
  id                     String      @id @default(cuid())
  promptId               String
  version                Int
  content                String      @db.Text
  createdAt              DateTime    @default(now())
  createdById            String      @db.Uuid
  prompt                 Prompt      @relation("PromptVersions", fields: [promptId], references: [id])
  createdBy              User        @relation("PromptVersionCreatedBy", fields: [createdById], references: [id])
  currentFor             Prompt?     @relation("PromptCurrentVersion")
  firefliesForInterviews Interview[]

  @@unique([promptId, version])
  @@index([promptId, createdAt])
}

// The email-template counterpart to Prompt/PromptVersion — same versioned
// pattern, but simpler: no `key` (templates are picked from a dropdown by
// name, never referenced by code) and no `interviewType`.
model EmailTemplate {
  id               String                 @id @default(cuid())
  name             String
  description      String?
  isActive         Boolean                @default(true)
  currentVersionId String?                @unique
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdById      String                 @db.Uuid
  updatedById      String                 @db.Uuid
  createdBy        User                   @relation("EmailTemplateCreatedBy", fields: [createdById], references: [id])
  updatedBy        User                   @relation("EmailTemplateUpdatedBy", fields: [updatedById], references: [id])
  currentVersion   EmailTemplateVersion?  @relation("EmailTemplateCurrentVersion", fields: [currentVersionId], references: [id])
  versions         EmailTemplateVersion[] @relation("EmailTemplateVersions")
}

// Immutable history, same pattern as PromptVersion.
model EmailTemplateVersion {
  id              String           @id @default(cuid())
  emailTemplateId String
  version         Int
  subject         String
  bodyHtml        String           @db.Text
  createdAt       DateTime         @default(now())
  createdById     String           @db.Uuid
  emailTemplate   EmailTemplate    @relation("EmailTemplateVersions", fields: [emailTemplateId], references: [id])
  createdBy       User             @relation("EmailTemplateVersionCreatedBy", fields: [createdById], references: [id])
  currentFor      EmailTemplate?   @relation("EmailTemplateCurrentVersion")
  usedForEmails   CandidateEmail[]

  @@unique([emailTemplateId, version])
  @@index([emailTemplateId, createdAt])
}

// A small library of static, company-wide substitution values (Company
// Name, Company Name Short, etc.) — admin-managed, unversioned, distinct
// from the fixed per-candidate/job/recruiter dynamic variables which are
// code-backed (see lib/email-variables.ts) rather than DB-editable.
model EmailVariable {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A single sent candidate email — full content lives here for the
// Communication tab; the Activity Feed only shows a one-line summary.
enum EmailStatus {
  SCHEDULED
  // Transient "claimed by the cron sender, delivery in flight" state — the
  // idempotency guard against Cloud Scheduler's at-least-once delivery.
  // Gmail's send API has no idempotency key, so a row must be atomically
  // claimed out of SCHEDULED before the Gmail call happens, not after.
  SENDING
  SENT
  CANCELED
  FAILED
}

model CandidateEmail {
  id                     String                @id @default(cuid())
  candidateId            String
  applicationId          String?
  senderId               String                @db.Uuid
  toAddress              String
  subject                String
  bodyHtml               String                @db.Text
  // Which template version this was generated from, if any — same audit
  // pattern as Interview.firefliesPromptVersionId.
  emailTemplateVersionId String?
  status                 EmailStatus           @default(SENT)
  // Set for a scheduled send; null for one sent immediately.
  scheduledFor           DateTime?
  // When it actually went out — distinct from createdAt, which for a
  // scheduled email is when it was composed/queued, not sent.
  sentAt                 DateTime?
  failureReason          String?               @db.Text
  attempts               Int                   @default(0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  candidate              Candidate             @relation(fields: [candidateId], references: [id])
  application            Application?          @relation(fields: [applicationId], references: [id])
  sender                 User                  @relation(fields: [senderId], references: [id])
  emailTemplateVersion   EmailTemplateVersion? @relation(fields: [emailTemplateVersionId], references: [id])

  @@index([candidateId, createdAt])
  @@index([status, scheduledFor])
}
